# build/pins.env — single source for every external artifact.
# Resolve KERNEL_URL/SHA once from the firecracker-microvm getting-started guide
# (their CI vmlinux for the current release line), record BOTH here, then never
# change silently: bumping a pin is a reviewed commit.
#
# Resolved 2026-07-31 on the connected build box. Every sha below was computed
# from the actually-downloaded bytes, not copied from a web page.
#
# vmlinux-6.18.36 from CI prefix firecracker-ci/20260729-c69d0c0490e6-0/, selected
# by the getting-started guide's own rule (newest dated prefix, `sort -V | tail -1`
# over the x86_64 vmlinux-N.N.N keys).
KERNEL_URL="https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/20260729-c69d0c0490e6-0/x86_64/vmlinux-6.18.36"
KERNEL_SHA256="ea80af24a5bf880b643c3730147502761743185b6fe7d1e1093c8224dcada9fd"
# X-2: a git TAG is mutable — it can be moved or deleted upstream and the clone is
# authenticated only by TLS. Pin the full 40-character commit SHA instead. Resolve it
# once from the llama.cpp release you chose (e.g. `git ls-remote --tags` for the tag,
# then the commit it points at) and record the tag name in the comment for humans.
# Release tag b10216 (ggml-org/llama.cpp), resolved 2026-07-31 via
# `git ls-remote --tags https://github.com/ggml-org/llama.cpp`. The b* tags are
# lightweight, so the ref's object IS the commit (no ^{} peel entry exists).
LLAMA_CPP_COMMIT="876a4321163249c43ca4e986818fab5ab081f282"   # tag b10216
# static busybox binary URL — resolve + pin same as kernel
# 1.35.0-x86_64-linux-musl is the newest x86_64 static build published under
# busybox.net/downloads/binaries/. Verified to provide BOTH applets the guest probe
# hard-requires (`nc`, `ip`) — a build missing either would trip SKIFF-PROBE-BROKEN.
BUSYBOX_URL="https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox"
BUSYBOX_SHA256="6e123e7f3202a8c1e9b1f94d8941580a25135382b99e8d3e34fb858bba311348"
# pinned firecracker release tarball (x86_64) — design review I4: the hypervisor
# itself must be pinned, not "whatever release was current that day"
# v1.16.1, latest stable release as of 2026-07-31. Our computed sha matches the
# upstream firecracker-v1.16.1-x86_64.tgz.sha256.txt published beside the asset.
FIRECRACKER_URL="https://github.com/firecracker-microvm/firecracker/releases/download/v1.16.1/firecracker-v1.16.1-x86_64.tgz"
FIRECRACKER_SHA256="382a02a869e4d6d5cb14c40577f9545e8458021ea8b0b2d3fc10ec14d9c242e6"
# the chosen Qwen GGUF — verify its licence page is Apache-2.0 BEFORE pinning
#
# Licence gate PASSED: Apache-2.0, evidence in docs/model-licence-check.md.
# Source is ggml-org — the llama.cpp organisation itself, i.e. the SAME upstream
# LLAMA_CPP_COMMIT above is pinned from. The official Qwen/Qwen3-1.7B-GGUF repo
# publishes only Q8_0 (1.83 GB) and no Q4 at any size, so the Q4_K_M this bundle
# is sized around had to come from a requantizer; choosing ggml-org means the
# bundle adds no new trust anchor beyond the two it already has (Qwen upstream,
# ggml-org). base_model is declared as Qwen/Qwen3-1.7B.
# sha256 below was computed from the downloaded bytes AND matches the x-linked-etag
# HuggingFace reports for the file (independent cross-check).
MODEL_URL="https://huggingface.co/ggml-org/Qwen3-1.7B-GGUF/resolve/main/Qwen3-1.7B-Q4_K_M.gguf"
MODEL_SHA256="d2387ca2dbfee2ffabce7120d3770dadca0b293052bc2f0e138fdc940d9bc7b5"
# Filename the bundle expects under models/ (config.yaml's `model:` value). The
# upstream basename will not match it — save the download to this name.
MODEL_FILE="qwen3-1.7b-q4.gguf"
